   "source": [
    "import numpy as np\n",
    "from pymoo.indicators.hv import HV\n",
    "\n",
    "def calculate_refpoint(costs, alpha=1.0):\n",
    "    ref = np.max(costs, axis=0)\n",
    "    for i in range(len(ref)):\n",
    "        ref[i] = ref[i] * (alpha)\n",
    "    return ref"
   ]
  }
